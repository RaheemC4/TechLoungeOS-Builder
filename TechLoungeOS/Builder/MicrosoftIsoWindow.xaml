<Window x:Class="TechLoungeOS.MicrosoftIsoWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Download Windows 11" Width="650" Height="480" MinWidth="510" MinHeight="450" WindowStartupLocation="CenterOwner" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" FontFamily="{StaticResource BodyFont}" FontSize="14" UseLayoutRounding="True" Icon="Assets/TechLoungeOS-Builder-v2.ico">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Download Windows 11" FontFamily="{StaticResource BrandFont}" FontSize="26" Margin="0,0,0,8"/><TextBlock Text="Direct from Microsoft · x64 for Intel and AMD PCs" Style="{StaticResource Caption}" TextWrapping="Wrap"/></StackPanel>
  <StackPanel x:Name="DownloadBody" Grid.Row="1" Margin="0,18,0,12">
   <StackPanel x:Name="LanguageSelection"><TextBlock Text="Windows language" Margin="0,0,0,7"/><ComboBox x:Name="LanguagesChoice" DisplayMemberPath="DisplayName" IsEnabled="False" AutomationProperties.Name="Windows download language"/></StackPanel>
   <Border x:Name="ManualLinkPanel" Visibility="Collapsed" Margin="0,12,0,0"><StackPanel><TextBlock Text="Microsoft may require you to use its website. Choose your language there, then copy its 64-bit ISO download link here." TextWrapping="Wrap" Style="{StaticResource Caption}"/><TextBox x:Name="DirectLinkBox" Margin="0,8,0,0" TextChanged="DirectLinkChanged" AutomationProperties.Name="Microsoft 64-bit ISO download link"/></StackPanel></Border>
   <TextBlock x:Name="DownloadStatus" Text="Getting Microsoft's available languages…" Margin="0,14,0,8" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <ProgressBar x:Name="DownloadProgress" Height="4" IsIndeterminate="True" Margin="0,8,0,8"/>
   <TextBlock x:Name="DownloadHint" Text="Existing ISOs are kept. A Windows licence is required." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"/>
   <WrapPanel x:Name="RecoveryActions" Visibility="Collapsed" Margin="0,10,0,0"><Button Content="Open Microsoft website" Click="WebsiteClick" AutomationProperties.HelpText="Opens Microsoft's official Windows 11 download page if automatic downloading is unavailable."/><Button x:Name="RetryCatalogue" Content="Try again" Click="RetryClick"/></WrapPanel>
  </StackPanel>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="DownloadClose" Content="Cancel" Click="CloseClick"/><Button x:Name="DownloadStart" Content="Download ISO…" Click="DownloadClick" IsEnabled="False" Style="{StaticResource Primary}"/></StackPanel>
 </Grid>
</Window>
