<Application x:Class="TechLoungeOS.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ThemeMode="Dark">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.Dark.xaml"/></ResourceDictionary.MergedDictionaries>

   <FontFamily x:Key="BodyFont">Segoe UI Variable Text</FontFamily><FontFamily x:Key="HeadingFont">Segoe UI Variable Display</FontFamily><FontFamily x:Key="BrandFont">Segoe UI Variable Text</FontFamily>
   <SolidColorBrush x:Key="Canvas" Color="#171717"/><SolidColorBrush x:Key="Surface" Color="#202020"/>
   <SolidColorBrush x:Key="Ink" Color="#F0F3F5"/><SolidColorBrush x:Key="Muted" Color="#B8B8B8"/>
   <SolidColorBrush x:Key="Line" Color="#414141"/><SolidColorBrush x:Key="Accent" Color="#99C4FF"/>
   <SolidColorBrush x:Key="AccentText" Color="#10213B"/><SolidColorBrush x:Key="Tint" Color="#2B3038"/>
   <Style x:Key="NavigationIcon" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe Fluent Icons"/><Setter Property="FontSize" Value="16"/><Setter Property="Width" Value="18"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Focusable" Value="False"/><Setter Property="IsHitTestVisible" Value="False"/></Style>
   <Style x:Key="AppChoice" TargetType="ToggleButton">
    <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/><Setter Property="FontSize" Value="14"/>
    <Setter Property="Margin" Value="0,4"/><Setter Property="Padding" Value="12,10"/><Setter Property="MinHeight" Value="62"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Grid SnapsToDevicePixels="True">
     <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6"/>
     <Border x:Name="Selected" Background="{DynamicResource Tint}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="6" Opacity="0" IsHitTestVisible="False"/>
     <Border x:Name="Hover" Background="{DynamicResource Ink}" CornerRadius="6" Opacity="0" IsHitTestVisible="False"/>
     <Grid Margin="{TemplateBinding Padding}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/><Border Grid.Column="1" Width="19" Height="19" CornerRadius="4" BorderBrush="{DynamicResource Muted}" BorderThickness="1" VerticalAlignment="Center"><TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/></Border></Grid>
     <Border x:Name="Focus" BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="5" Margin="3" Opacity="0" IsHitTestVisible="False"/>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
   <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="13"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="18"/></Style>
   <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"><Setter Property="Padding" Value="12,5"/><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="MinHeight" Value="32"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
   <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}"><Setter Property="Padding" Value="12,5"/><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="MinHeight" Value="32"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource AccentText}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="ToolTipService.ShowOnDisabled" Value="True"/><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/></Trigger></Style.Triggers></Style>
   <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}"><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="0,6,8,10"/><Setter Property="MinHeight" Value="32"/></Style>
   <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}"><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="0,6,8,10"/><Setter Property="MinHeight" Value="32"/></Style>
   <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}"><Setter Property="Margin" Value="0,7"/></Style>
   <Style TargetType="Expander" BasedOn="{StaticResource DefaultExpanderStyle}"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
   <Style x:Key="Step" TargetType="RadioButton"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="16,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Tile" CornerRadius="4" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"><Grid><Border x:Name="Indicator" Width="3" Height="16" CornerRadius="1" Background="{DynamicResource Accent}" HorizontalAlignment="Left" Visibility="Collapsed"/><ContentPresenter Margin="{TemplateBinding Padding}"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource Tint}"/><Setter TargetName="Indicator" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Line}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
   <Style TargetType="GroupBox"><Setter Property="Background" Value="#272727"/><Setter Property="Padding" Value="20"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupBox"><Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}"><StackPanel><TextBlock Text="{TemplateBinding Header}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/><ContentPresenter/></StackPanel></Border></ControlTemplate></Setter.Value></Setter></Style>
  </ResourceDictionary>
 </Application.Resources>
</Application>
