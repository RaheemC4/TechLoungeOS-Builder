<Window x:Class="TechLoungeOS.BootDriveWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Create a Windows setup drive" Width="720" Height="700" MinWidth="620" MinHeight="520" WindowStartupLocation="CenterOwner" FontFamily="{StaticResource BodyFont}" FontSize="14" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Create a setup drive" FontSize="26"/><TextBlock x:Name="SourceHint" Text="Your selected ISO and customisations are used automatically." Style="{StaticResource Caption}" Margin="0,6,0,16"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="Windows image"/><TextBlock x:Name="Source" Margin="0,6,0,16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Selected Windows image"/>
   <TextBlock x:Name="IsoSaveSummary" Visibility="Collapsed" Style="{StaticResource Caption}" Margin="0,0,0,12"/>
   <DockPanel><Button DockPanel.Dock="Right" Content="Refresh drives" Click="RefreshClick"/><TextBlock Text="USB drive" VerticalAlignment="Center"/></DockPanel>
   <ComboBox x:Name="Drives" DisplayMemberPath="Label" MinHeight="36" Margin="0,8,0,8" AutomationProperties.Name="USB target drive"/>
   <TextBlock Text="USB drive label" Margin="0,8,0,0"/><TextBox x:Name="UsbLabel" Text="TLOS_SETUP" MaxLength="11" AutomationProperties.Name="USB drive label"/><TextBlock Text="Up to 11 letters, numbers, spaces, hyphens or underscores." Style="{StaticResource Caption}"/>
   <TextBlock Text="Supports compatible UEFI and BIOS PCs. The source image must include the required boot files; CPU and driver limitations still apply." Style="{StaticResource Caption}"/>
   <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="14" CornerRadius="4" Margin="0,18,0,14"><StackPanel><TextBlock Text="This erases the selected USB drive." FontWeight="SemiBold"/><TextBlock Text="The app prepares and checks the files first. You will review the exact drive and confirm the erase before writing starts. Internal and Windows drives cannot be selected." Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel></Border>
   <TextBlock x:Name="Message" Text="Select your USB drive." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <Expander Header="Activity and recovery details" Margin="0,16,0,0"><TextBox x:Name="Activity" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="120" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="USB activity log"/></Expander>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,18,0,0"><ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Start" Content="Create setup USB" Style="{StaticResource Primary}" Click="StartClick"/><Button x:Name="Stop" Content="Cancel" IsEnabled="False" Click="CancelClick"/><Button x:Name="CloseButton" Content="Close" Click="CloseClick"/></StackPanel></StackPanel>
 </Grid>
</Window>
