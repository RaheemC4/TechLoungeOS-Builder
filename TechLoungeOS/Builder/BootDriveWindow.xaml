<Window x:Class="TechLoungeOS.BootDriveWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TechLoungeOS" Title="Create a Windows setup drive" Width="760" Height="720" MinWidth="620" MinHeight="520" WindowStartupLocation="CenterOwner" FontFamily="{StaticResource BodyFont}" FontSize="14" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" UseLayoutRounding="True">
 <Grid x:Name="BootRoot" Margin="24" Background="{DynamicResource Canvas}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Create a setup drive" FontSize="26"/><TextBlock x:Name="SourceHint" Text="Your selected ISO and customisations are used automatically." Style="{StaticResource Caption}" Margin="0,6,0,10"/><TextBlock x:Name="Source" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Selected Windows image" Margin="0,0,0,12"/><TextBlock x:Name="IsoSaveSummary" Visibility="Collapsed" Style="{StaticResource Caption}" Margin="0,0,0,8"/></StackPanel>
  <StackPanel x:Name="OptionsPanel" Grid.Row="1">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,12,0"><DockPanel><Button DockPanel.Dock="Right" Content="Refresh drives" Click="RefreshClick" FontSize="12" Padding="7,3" Margin="0"/><TextBlock Text="USB drive" VerticalAlignment="Center"/></DockPanel><ComboBox x:Name="Drives" DisplayMemberPath="Label" MinHeight="36" Margin="0,8,0,0" AutomationProperties.Name="USB target drive"/></StackPanel>
    <StackPanel Grid.Column="1"><TextBlock Text="USB drive label" Margin="0,5,0,0"/><TextBox x:Name="UsbLabel" Text="TLOS_SETUP" MaxLength="11" Margin="0,9,0,0" AutomationProperties.Name="USB drive label" ToolTip="Up to 11 letters, numbers, spaces, hyphens or underscores."/></StackPanel>
   </Grid>
   <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="12" CornerRadius="6" Margin="0,12,0,8"><StackPanel><TextBlock Text="This erases the selected USB drive." FontWeight="SemiBold"/><TextBlock Text="Confirm your drive once at the start. After the files are checked, writing continues automatically." Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></Border>
  </StackPanel>
  <DockPanel Grid.Row="2" Margin="0,8,0,0"><DockPanel DockPanel.Dock="Top" Margin="0,0,0,6"><Button DockPanel.Dock="Right" Content="Save diagnostic log…" Click="SaveDiagnosticLog" FontSize="12" Padding="8,4" Margin="0"/><TextBlock Text="Activity" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
   <ScrollViewer x:Name="ActivityScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,3,0"><ItemsControl x:Name="ActivityItems" ItemTemplate="{StaticResource ActivityCardTemplate}"/></ScrollViewer>
  </DockPanel>
  <StackPanel Grid.Row="3" Margin="0,12,0,0"><Border x:Name="ResultBanner" Background="{DynamicResource Tint}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12"><StackPanel>
   <TextBlock x:Name="StepCaption" Visibility="Collapsed" FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,0,0,6"/>
   <TextBlock x:Name="ResultHeading" Text="Ready to create your USB" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap"/>
   <TextBlock x:Name="Message" Text="Select your USB drive." TextWrapping="Wrap" Margin="0,5,0,0" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock x:Name="StatusMessage" Text="Select your USB drive." Visibility="Collapsed"/>
   <TextBlock x:Name="TransferCaption" Visibility="Collapsed" FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,8,0,0" Typography.NumeralAlignment="Tabular"/>
   <TextBlock x:Name="ElapsedCaption" Visibility="Collapsed" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" Typography.NumeralAlignment="Tabular" TextWrapping="Wrap"/>
   <ProgressBar x:Name="TransferProgress" Visibility="Collapsed" Height="3" Minimum="0" Maximum="100" Foreground="{DynamicResource Accent}" Margin="0,10,0,0" AutomationProperties.Name="USB file progress"><ProgressBar.Template><ControlTemplate TargetType="ProgressBar"><Grid ClipToBounds="True"><Border x:Name="PART_Track" Background="{DynamicResource Line}" CornerRadius="1.5"/><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="1.5"/></Grid></ControlTemplate></ProgressBar.Template></ProgressBar>
   <local:ActivityIndicator x:Name="Progress" Visibility="Collapsed" Margin="0,10,0,0"/>
  </StackPanel></Border><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Start" Content="Create setup USB" Style="{StaticResource Primary}" Click="StartClick"/><Button x:Name="Stop" Content="Cancel" IsEnabled="False" Click="CancelClick"/><Button x:Name="CloseButton" Content="Close" Click="CloseClick"/></StackPanel></StackPanel>
  <Border x:Name="SuccessPanel" Grid.RowSpan="4" Visibility="Collapsed" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="18" TextElement.FontFamily="pack://application:,,,/TechLoungeOS.Builder;component/Fonts/#Sora">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="SETUP COMPLETE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,12"/>
    <StackPanel Grid.Row="1" VerticalAlignment="Center">
     <Grid x:Name="SuccessHero"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0"><TextBlock x:Name="SuccessHeading" Text="Your setup USB is ready" FontSize="26" LineHeight="34" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/></StackPanel>
      <Viewbox Grid.Column="1" Height="70" VerticalAlignment="Center" IsHitTestVisible="False"><Canvas Width="200" Height="100">
       <Path Data="M 40,25 L 7,25 Q 3,25 3,30 L 3,70 Q 3,75 7,75 L 40,75" Stroke="{DynamicResource Muted}" StrokeThickness="3"/><Rectangle Canvas.Left="14" Canvas.Top="37" Width="7" Height="7" Fill="{DynamicResource Muted}"/><Rectangle Canvas.Left="14" Canvas.Top="56" Width="7" Height="7" Fill="{DynamicResource Muted}"/>
       <Rectangle Canvas.Left="40" Canvas.Top="12" Width="154" Height="76" RadiusX="15" RadiusY="15" Stroke="{DynamicResource Ink}" StrokeThickness="3" Fill="{DynamicResource Surface}"/>
       <Path Data="M 64,34 H 82 V 49 H 64 Z M 87,34 H 105 V 49 H 87 Z M 64,54 H 82 V 69 H 64 Z M 87,54 H 105 V 69 H 87 Z" Fill="{DynamicResource Accent}"/>
       <Ellipse Canvas.Left="124" Canvas.Top="31" Width="39" Height="39" Stroke="{DynamicResource Accent}" StrokeThickness="2.5"/><Path Data="M 134,50 L 142,58 L 155,42" Stroke="{DynamicResource Accent}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
      </Canvas></Viewbox>
     </Grid>
     <Border Background="{DynamicResource Tint}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,14,0,12"><StackPanel><TextBlock x:Name="SuccessDrive" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="SuccessTiming" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Border>
     <TextBlock Text="Next: install Windows" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <StackPanel x:Name="SuccessInstructions">
      <TextBlock FontSize="13" TextWrapping="Wrap" Margin="0,0,0,6"><Run Text="&#xE7E8;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource Accent}"/><Run Text="   For this PC, restart and open its boot menu."/></TextBlock>
      <TextBlock FontSize="13" TextWrapping="Wrap" Margin="0,0,0,6"><Run Text="&#xE770;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource Accent}"/><Run Text="   For another PC, safely eject the USB before moving it."/></TextBlock>
      <TextBlock FontSize="13" TextWrapping="Wrap"><Run Text="&#xE765;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource Accent}"/><Run Text="   Select the USB drive to start Windows setup."/></TextBlock>
     </StackPanel>
    </StackPanel>
    <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,20,0,0"><DockPanel><Button Content="View activity" Click="ViewCompletedActivity" HorizontalAlignment="Left"/><Button x:Name="SuccessDone" Content="Done" Style="{StaticResource Primary}" Click="CloseClick" IsCancel="True" HorizontalAlignment="Right" MinWidth="100"/></DockPanel></Border>
   </Grid>
  </Border>
 </Grid>
</Window>
