<Window x:Class="TechLoungeOS.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TechLoungeOS" Title="TechLoungeOS Builder" WindowStartupLocation="CenterScreen" Icon="Assets/TechLoungeOS-Builder-v2.ico" Width="1160" Height="860" MinWidth="720" MinHeight="500" FontFamily="{StaticResource BodyFont}" FontSize="14" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" UseLayoutRounding="True">
 <Grid x:Name="Shell" Background="{DynamicResource Canvas}"><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.ColumnSpan="2" Background="{DynamicResource Canvas}" Padding="24,0"><DockPanel>
   <Button x:Name="RecoveryButton" DockPanel.Dock="Right" Content="Restore previous version" Click="RecoverUpdateClick" Visibility="Collapsed" VerticalAlignment="Center"/>
   <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
    <Button x:Name="CheckUpdatesButton" Click="CheckUpdateClick" HorizontalAlignment="Right" Margin="0" Padding="8,3" MinHeight="30" FontSize="12" ToolTip="Check for TechLoungeOS Builder app updates. This does not update Windows inside your ISO." AutomationProperties.Name="Check for updates" AutomationProperties.HelpText="Checks for Builder app updates, not Windows image updates."><Button.ContextMenu><ContextMenu><MenuItem Header="Install app update from files…" Click="LocalUpdateClick"/></ContextMenu></Button.ContextMenu><StackPanel Orientation="Horizontal"><TextBlock x:Name="UpdateCheckIcon" Text="&#xE895;" Style="{StaticResource NavigationIcon}" FontSize="14" Width="16" Margin="0,0,6,0" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><RotateTransform/></TextBlock.RenderTransform></TextBlock><TextBlock x:Name="CheckUpdatesLabel" Text="Check for updates" VerticalAlignment="Center"/><Border x:Name="UpdateAvailableBadge" Visibility="Collapsed" Background="{DynamicResource Accent}" CornerRadius="3" Margin="7,0,0,0" Padding="4,0"><TextBlock Text="New" FontSize="11" Foreground="{DynamicResource AccentText}"/></Border></StackPanel></Button>
    <TextBlock x:Name="UpdateMessage" Visibility="Collapsed" Text="Use Check for updates to update this app."/>
    <Grid x:Name="UpdateFeedbackSlot" Width="220" Height="16" Margin="0,2,0,0" HorizontalAlignment="Right">
     <TextBlock x:Name="PreviousUpdateFeedback" Opacity="0" TextAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="11" IsHitTestVisible="False"/>
     <TextBlock x:Name="UpdateFeedback" TextAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="11" ToolTip="{Binding Text, ElementName=UpdateMessage}" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
   </StackPanel>
   <Button x:Name="InstallUpdateButton" DockPanel.Dock="Right" Content="Install and restart" Click="InstallUpdateClick" Visibility="Collapsed" VerticalAlignment="Center"/>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Assets/TechLoungeOS-Builder-v2.png" Width="28" Height="28" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="TechLoungeOS Builder" FontFamily="{StaticResource BrandFont}" FontWeight="Normal" FontSize="14"/></StackPanel>
  </DockPanel></Border>
  <Border Grid.Row="1" Padding="14,22,14,20"><DockPanel>
   <TextBlock DockPanel.Dock="Top" Text="BUILD STEPS" Style="{StaticResource Caption}" FontSize="11" Margin="14,0,0,18"/>

   <Border x:Name="ImageSummary" DockPanel.Dock="Bottom" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12,16,12,0"><StackPanel><TextBlock Text="Current image" FontSize="13" FontWeight="Normal"/><TextBlock x:Name="SelectedImageLabel" Text="No image selected" FontWeight="Normal" Margin="0,10,0,4"/><TextBlock x:Name="SelectedImageDetails" Text="Import a Windows 11 ISO to begin." Style="{StaticResource Caption}"/><TextBlock Text="Original kept unless you choose to replace it." Style="{StaticResource Caption}" FontSize="11" Margin="0,12,0,0"/></StackPanel></Border>
   <StackPanel x:Name="Navigation" VerticalAlignment="Top"><RadioButton x:Name="SourceStep" GroupName="Steps" Style="{StaticResource Step}" Tag="0" IsChecked="True" Checked="StepChecked" AutomationProperties.Name="Windows image"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" Style="{StaticResource NavigationIcon}"/><TextBlock Text="Windows image" FontSize="13" VerticalAlignment="Center"/></StackPanel></RadioButton><RadioButton x:Name="ComponentsStep" GroupName="Steps" Style="{StaticResource Step}" Tag="1" Checked="StepChecked" AutomationProperties.Name="Components"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource NavigationIcon}"/><TextBlock Text="Components" FontSize="13" VerticalAlignment="Center"/></StackPanel></RadioButton><RadioButton x:Name="AppsStep" GroupName="Steps" Style="{StaticResource Step}" Tag="2" Checked="StepChecked" AutomationProperties.Name="Apps &amp; setup"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A9;" Style="{StaticResource NavigationIcon}"/><TextBlock Text="Apps &amp; setup" FontSize="13" VerticalAlignment="Center"/></StackPanel></RadioButton><RadioButton x:Name="PersonalisationStep" GroupName="Steps" Style="{StaticResource Step}" Tag="3" Checked="StepChecked" AutomationProperties.Name="Personalisation"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE771;" Style="{StaticResource NavigationIcon}"/><TextBlock Text="Personalisation" FontSize="13" VerticalAlignment="Center"/></StackPanel></RadioButton><RadioButton x:Name="ExportStep" GroupName="Steps" Style="{StaticResource Step}" Tag="4" Checked="StepChecked" AutomationProperties.Name="Finish"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE792;" Style="{StaticResource NavigationIcon}"/><TextBlock Text="Finish" FontSize="13" VerticalAlignment="Center"/></StackPanel></RadioButton></StackPanel>
  </DockPanel></Border>
  <Border Grid.Row="1" Grid.Column="1" Margin="0,0,14,14" Background="{DynamicResource Surface}" CornerRadius="6"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border x:Name="AtmosphereLayer" CornerRadius="6" Grid.RowSpan="4" IsHitTestVisible="False" Opacity="0.3"><Border.Background><RadialGradientBrush x:Name="AtmosphereBrush" Center="0.9,0.05" GradientOrigin="0.9,0.05" RadiusX="1" RadiusY="0.85"><GradientStop Color="#284D71" Offset="0"/><GradientStop Color="#00202020" Offset="1"/></RadialGradientBrush></Border.Background></Border>
   <StackPanel Margin="28,26,28,22"><TextBlock x:Name="StepTitle" FontFamily="{StaticResource HeadingFont}" Text="Windows image" FontSize="28" FontWeight="Normal" Margin="0,8,0,6"/><TextBlock x:Name="StepDescription" Text="Choose a Windows 11 ISO to customise." Style="{StaticResource Caption}"/></StackPanel>
   <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,0,20,6"><StackPanel x:Name="Inputs">
    <GroupBox x:Name="SourcePage" Header="Installation image"><StackPanel>
     <Border Background="{DynamicResource Tint}" CornerRadius="6" Padding="14" Margin="0,0,0,18"><DockPanel><Button x:Name="DownloadWindowsIsoButton" DockPanel.Dock="Right" Click="DownloadWindowsIsoClick" Style="{StaticResource Primary}" Margin="12,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Download Windows 11 ISO from Microsoft"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource NavigationIcon}"/><TextBlock Text="Download Windows 11" VerticalAlignment="Center"/></StackPanel></Button><StackPanel VerticalAlignment="Center"><TextBlock Text="Need a Windows ISO?" FontWeight="SemiBold"/><TextBlock Text="Get a fresh x64 image directly from Microsoft." Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></DockPanel></Border>
     <DockPanel Margin="0,0,0,20"><Button DockPanel.Dock="Right" Content="Browse…" Click="ImportClick" Margin="16,0,0,0"/><Border DockPanel.Dock="Left" BorderBrush="{DynamicResource Line}" BorderThickness="1" Width="40" Height="46" CornerRadius="2" Margin="0,0,14,0"><TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock x:Name="IsoFileName" Text="No ISO selected" FontSize="15" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="IsoPath" Text="Choose a Windows 11 installation image." Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="Source ISO"/></StackPanel></DockPanel>
     <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,18,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0" VerticalAlignment="Center"><TextBlock Text="Windows edition"/><TextBlock x:Name="EditionHint" Text="Available after importing your ISO." Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel><ComboBox Grid.Column="1" x:Name="Editions" IsEnabled="False" SelectionChanged="EditionChanged" DisplayMemberPath="ImageName" AutomationProperties.Name="Windows edition" Margin="0" VerticalAlignment="Center"/></Grid></Border>
     <TextBlock x:Name="SourceProfileStatus" Text="Source origin unverified. Existing components and service settings are the preservation baseline." Style="{StaticResource Caption}" Margin="0,22,0,0"/>
     <Expander x:Name="WindowsUpdatesSection" Header="Windows updates in this ISO" Margin="0,18,0,0"><StackPanel Margin="0,10,0,0">
      <UniformGrid Columns="2" Margin="0,0,0,12"><Border Background="{DynamicResource Tint}" CornerRadius="4" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="Your ISO" Style="{StaticResource Caption}"/><TextBlock x:Name="WindowsCurrentName" Text="Choose a Windows edition" FontWeight="SemiBold" Margin="0,4,0,4"/><TextBlock x:Name="WindowsCurrentDetails" Style="{StaticResource Caption}"/></StackPanel></Border><Border Background="{DynamicResource Tint}" CornerRadius="4" Padding="12"><StackPanel><TextBlock Text="Latest supported stable target" Style="{StaticResource Caption}"/><TextBlock x:Name="WindowsLatestName" Text="Not checked yet" FontWeight="SemiBold" Margin="0,4,0,4"/><TextBlock x:Name="WindowsLatestDetails" Style="{StaticResource Caption}"/></StackPanel></Border></UniformGrid>
      <Button x:Name="WindowsVersionCheck" IsEnabled="False" Click="WindowsVersionCheckClick" HorizontalAlignment="Left" AutomationProperties.Name="Check Windows version in ISO"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE895;" Style="{StaticResource NavigationIcon}"/><TextBlock Text="Check Windows version" VerticalAlignment="Center"/></StackPanel></Button>
      <TextBlock x:Name="WindowsVersionStatus" Text="Import an ISO and choose an edition to check its Windows version." Style="{StaticResource Caption}" Margin="0,8,0,10" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock x:Name="WindowsVersionChecked" Style="{StaticResource Caption}" Margin="0,0,0,8"/><TextBlock x:Name="WindowsNewRelease" Visibility="Collapsed" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
      <CheckBox x:Name="UpdateWindowsImage" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Include latest supported Windows release and updates"><TextBlock Text="Include the latest supported Windows release and updates" TextWrapping="Wrap"/></CheckBox>
      <TextBlock Text="Downloads Microsoft packages during the build, including supported enablement upgrades. Preview updates and unknown upgrade routes are excluded. Existing tweaks and removals must pass preservation checks. A stripped or unhealthy image may need to stay on its current release." Style="{StaticResource Caption}"/>
      <TextBlock Text="Checking here changes nothing. The top-right Check for updates button updates the Builder app." Style="{StaticResource Caption}" Margin="0,8,0,0"/>
     </StackPanel></Expander>
     <Border x:Name="ExistingIsoUsbEntry" Background="{DynamicResource Tint}" CornerRadius="6" Padding="14" Margin="0,18,0,0">
      <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedItem, ElementName=Editions}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
      <DockPanel><Button x:Name="ExistingIsoUsbButton" DockPanel.Dock="Right" Click="ExistingIsoUsbClick" Margin="12,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Create USB from existing ISO" AutomationProperties.HelpText="Copy an existing ISO to USB without changing the ISO."><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE88E;" Style="{StaticResource NavigationIcon}"/><TextBlock Text="Create setup USB…" VerticalAlignment="Center"/></StackPanel></Button><StackPanel VerticalAlignment="Center"><TextBlock Text="Already have a finished ISO?" FontWeight="SemiBold"/><TextBlock Text="Copy it directly to a USB drive." Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></DockPanel>
     </Border>
    </StackPanel></GroupBox>
    <GroupBox x:Name="ComponentsPage" Header="Optional components" Visibility="Collapsed"><StackPanel>
     <TextBlock Text="Select optional apps to remove. Nothing changes until you build." Style="{StaticResource Caption}"/>
     <WrapPanel Margin="0,14,0,12"><Button Content="Use gaming preset" Style="{StaticResource Primary}" Click="PresetClick"/><Button Content="Keep everything" Click="KeepClick"/></WrapPanel>
     <Border Background="{DynamicResource Tint}" CornerRadius="4" Padding="16" Margin="0,0,0,18"><TextBlock Text="Protected by default: Defender, Windows Update, recovery, Store, Xbox and shared gaming frameworks. Features already stripped from your source cannot be guaranteed." Style="{StaticResource Caption}"/></Border>
     <WrapPanel x:Name="Components"/>
    </StackPanel></GroupBox>
    <Border x:Name="AppsPage" Visibility="Collapsed"><StackPanel>
     <DockPanel><Button x:Name="SearchButton" DockPanel.Dock="Right" Content="Search apps" Style="{StaticResource Primary}" Click="SearchAppsClick"/><TextBox x:Name="AppQuery" AutomationProperties.Name="Search app name" ToolTip="Search apps, for example Steam or Firefox" KeyDown="AppQueryKeyDown" TextChanged="AppQueryChanged"/></DockPanel>
     <TextBlock x:Name="SearchStatus" Text="Search the WinGet community repository. Try Steam, Firefox or VLC." Style="{StaticResource Caption}"/>
     <StackPanel x:Name="SearchResultsSection" Visibility="Collapsed" RequestBringIntoView="SearchResultBringIntoView">
     <TextBlock x:Name="SearchResultsHeading" Text="Suggestions" Style="{StaticResource Caption}" FontSize="11" FontWeight="Normal" Margin="0,18,0,8"/>
     <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SearchResults"/></ScrollViewer>
     </StackPanel>
     <DockPanel Margin="0,20,0,8"><Button DockPanel.Dock="Right" Content="Clear selection" Click="ClearAppsClick" Padding="10,4" MinHeight="30"/><Button x:Name="RecommendedPresetButton" DockPanel.Dock="Right" Content="Recommended apps" Click="RecommendedAppsClick" Padding="10,4" MinHeight="30"/><TextBlock x:Name="SelectedCount" Text="Your app list (0)" FontWeight="Normal" VerticalAlignment="Center"/></DockPanel>
     <Expander x:Name="SelectedAppsDetails" Header="Review selected apps"><WrapPanel x:Name="Apps"/></Expander>
     <TextBlock Text="Keep the PC online while selected apps finish installing." Style="{StaticResource Caption}" Margin="0,16,0,0"/>
     <DockPanel Margin="0,16,0,6"><ComboBox x:Name="AppCategory" DockPanel.Dock="Right" MinWidth="150" Margin="8,0,0,0" SelectionChanged="AppCategoryChanged" AutomationProperties.Name="Browse app collection"><ComboBoxItem Content="Recommended" IsSelected="True"/><ComboBoxItem Content="All optional apps"/></ComboBox><TextBlock Text="Browse apps" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><UniformGrid x:Name="RecommendedApps" Columns="2"/><TextBlock Text="Click an app to select it. Click again to deselect." Style="{StaticResource Caption}" Margin="0,4,0,12"/>
    </StackPanel></Border>
    <Border x:Name="PersonalisationPage" Visibility="Collapsed"><StackPanel>
     <TextBlock Text="Background choice" Margin="0,14,0,4"/><ComboBox x:Name="WallpaperMode" SelectionChanged="WallpaperPresetChanged" AutomationProperties.Name="Wallpaper source"><ComboBoxItem Content="Built-in wallpapers"/><ComboBoxItem Content="My own picture"/><ComboBoxItem Content="Original ISO wallpaper"/></ComboBox>
     <Grid x:Name="WallpaperPresetControls" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Design" Margin="0,0,0,4"/><ComboBox x:Name="WallpaperDesign" DisplayMemberPath="Label" SelectionChanged="WallpaperPresetChanged" AutomationProperties.Name="Wallpaper design"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Colour" Margin="0,0,0,4"/><ComboBox x:Name="WallpaperColour" DisplayMemberPath="Label" SelectionChanged="WallpaperPresetChanged" AutomationProperties.Name="Wallpaper colour"/></StackPanel></Grid>
     <Border x:Name="WallpaperPreviewFrame" Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4" Height="180" Margin="0,18,0,16"><Grid><Image x:Name="WallpaperPreview" Stretch="Uniform"/><TextBlock x:Name="WallpaperPlaceholder" Text="Keep the source background" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
     <DockPanel x:Name="CustomWallpaperControls" Visibility="Collapsed"><Button DockPanel.Dock="Right" Content="Browse image…" Click="WallpaperClick"/><TextBox x:Name="WallpaperPath" IsReadOnly="True" AutomationProperties.Name="Desktop wallpaper image"/></DockPanel>
     <TextBlock Text="Each monitor gets its own centred wallpaper. You can change it later in Windows. Custom images: PNG, JPEG or BMP, up to 32 MB." Style="{StaticResource Caption}"/>
     <StackPanel Margin="0,16,0,0">
      <TextBlock Text="Region and keyboard" FontWeight="SemiBold"/>
      <TextBlock Text="Applied by the account wizard so Windows will not ask these questions again after installation. The ISO’s display language stays unchanged." Style="{StaticResource Caption}"/>
      <TextBlock Text="Region and date format" Margin="0,10,0,4"/><local:ChoicePicker x:Name="SetupRegionChoice" DisplayMemberPath="Label" AutomationProperties.Name="Search region or language" ToolTip="Type to filter the list, then choose a result."/>
      <TextBlock Text="Keyboard layout" Margin="0,10,0,4"/><local:ChoicePicker x:Name="SetupKeyboardChoice" DisplayMemberPath="Label" AutomationProperties.Name="Search keyboard layout" ToolTip="Type to filter the list, then choose a result."/>
      <TextBlock Text="Only layouts present in the selected Windows image can be included. Missing layouts stop the build before Windows components are changed." Style="{StaticResource Caption}"/>
     </StackPanel>
    </StackPanel></Border>
    <Border x:Name="ExportPage" Visibility="Collapsed"><StackPanel>
     <TextBlock Text="What would you like to create?"/><UniformGrid x:Name="OutputModes" Columns="3" Margin="0,10,0,0">
      <RadioButton x:Name="UsbOutput" GroupName="OutputDestination" Style="{StaticResource OutputOption}" IsChecked="True" Checked="OutputModeChanged" MouseEnter="OutputHoverChanged" MouseLeave="OutputHoverChanged" AutomationProperties.Name="Create setup USB only"><StackPanel><TextBlock Text="&#xE88E;" FontFamily="Segoe Fluent Icons" FontSize="23" Margin="0,0,0,10"/><TextBlock Text="Setup USB" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="No extra ISO file" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></RadioButton>
      <RadioButton x:Name="IsoOutputChoice" GroupName="OutputDestination" Style="{StaticResource OutputOption}" Checked="OutputModeChanged" MouseEnter="OutputHoverChanged" MouseLeave="OutputHoverChanged" AutomationProperties.Name="Save ISO only"><StackPanel><TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" FontSize="23" Margin="0,0,0,10"/><TextBlock Text="Save ISO" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Keep a customised image" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></RadioButton>
      <RadioButton x:Name="BothOutput" GroupName="OutputDestination" Style="{StaticResource OutputOption}" Checked="OutputModeChanged" MouseEnter="OutputHoverChanged" MouseLeave="OutputHoverChanged" AutomationProperties.Name="Save ISO and create USB"><StackPanel><TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="23" Margin="0,0,0,10"/><TextBlock Text="USB + ISO" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Create both together" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></RadioButton>
     </UniformGrid><TextBlock x:Name="OutputNextHint" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
     <StackPanel x:Name="IsoDestinationSection" Visibility="Collapsed"><TextBlock Text="ISO filename and location" FontWeight="Normal"/><DockPanel><Button DockPanel.Dock="Right" Content="Choose location…" Click="OutputClick"/><TextBox x:Name="OutputPath" AutomationProperties.Name="Output ISO path"/></DockPanel></StackPanel>
     <StackPanel x:Name="IsoToolSettings"><TextBlock Text="Microsoft ADK ISO tool" FontWeight="Normal" Margin="0,20,0,0"/><DockPanel><Button DockPanel.Dock="Right" Content="Locate tool…" Click="ToolClick"/><TextBox x:Name="OscdimgPath" AutomationProperties.Name="Oscdimg path"/></DockPanel><TextBlock Text="Select oscdimg.exe from the Windows Assessment and Deployment Kit." Style="{StaticResource Caption}"/></StackPanel>

     <Border Background="{DynamicResource Tint}" CornerRadius="4" Padding="16" Margin="0,22,0,0"><TextBlock Text="The image and USB files are checked before completion. Replacing an ISO or erasing a USB asks for confirmation. Older PCs still need compatible CPUs and drivers." Style="{StaticResource Caption}"/></Border>
     <Border x:Name="UsbNextStep" Visibility="Collapsed" Background="{DynamicResource Tint}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,20,0,0"><Grid>
      <StackPanel><TextBlock Text="Last completed ISO" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="UsbOutputLabel" TextTrimming="CharacterEllipsis" Style="{StaticResource Caption}" Margin="0,6,0,0"/><TextBlock Text="Build again after changing your choices." Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel>

     </Grid></Border>
    </StackPanel></Border>
   </StackPanel></ScrollViewer>
   <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,16,0,8" Margin="28,14,28,0"><StackPanel><ProgressBar x:Name="Busy" Height="3" Margin="0,0,0,10" Visibility="Collapsed" IsIndeterminate="True"/><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="PreviousStepButton" Visibility="Collapsed" Click="PreviousStepClick" AutomationProperties.Name="Back"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE76B;" Style="{StaticResource NavigationIcon}"/><TextBlock Text="Back" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="NextStepButton" IsEnabled="False" Style="{StaticResource Primary}" Click="NextStepClick" AutomationProperties.Name="Next"><StackPanel Orientation="Horizontal"><TextBlock Text="Next" VerticalAlignment="Center"/><TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></Button><Button x:Name="BuildButton" Visibility="Collapsed" IsEnabled="False" Style="{StaticResource Primary}" Click="BuildClick" AutomationProperties.Name="Build ISO"><StackPanel Orientation="Horizontal"><TextBlock x:Name="BuildActionIcon" Text="&#xE88E;" Style="{StaticResource NavigationIcon}"/><TextBlock x:Name="BuildActionLabel" Text="Create USB" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="CancelButton" Visibility="Collapsed" Content="Cancel" Click="CancelClick" IsEnabled="False" ToolTip="Waits for the current operation before cleanup"/></StackPanel><TextBlock x:Name="Status" Text="Import an ISO to begin." MaxHeight="52" TextTrimming="CharacterEllipsis" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/></DockPanel></StackPanel></Border>
   <Expander x:Name="BuildActivity" Grid.Row="3" Header="Activity" Expanded="ActivityExpanded" Margin="28,4,28,12"><StackPanel>
    <DockPanel Margin="0,6,0,4"><Button DockPanel.Dock="Right" Content="Diagnostic log" Click="OpenDiagnosticLog" FontSize="12" Padding="8,3" Margin="0"/><TextBlock Text="Recent activity · newest first" Style="{StaticResource Caption}" VerticalAlignment="Center"/></DockPanel>
    <ScrollViewer x:Name="ActivityScroll" Height="156" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="ActivityItems"><ItemsControl.ItemTemplate><DataTemplate>
     <Border Background="{DynamicResource Tint}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5" Padding="12,9" Margin="0,4,0,4" Loaded="ActivityRowLoaded"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,2,8,0"/>
      <StackPanel Grid.Column="1"><DockPanel><TextBlock Text="{Binding TimeLabel}" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource Muted}" Margin="10,0,0,0"/><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,3,0,0"/><TextBlock Text="{Binding State}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
     </Grid></Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   </StackPanel></Expander>
  </Grid></Border>
 </Grid>
</Window>
